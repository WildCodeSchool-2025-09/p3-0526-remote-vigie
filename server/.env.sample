# .env.sample - Sample Environment Variables

# Application Configuration
APP_PORT=3310
APP_SECRET=YOUR_APP_SECRET_KEY

# Google OAuth 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3310/api/auth/google/callback

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME

# Client URL (for CORS configuration)
CLIENT_URL=http://localhost:3000

# Météo-France
METEO_API_KEY=YOUR_METEO_API_KEY

# About specific needs, please ask your trainer about the deploiement project name and follow the pattern
# You can add as much variable as needed. Don't forget to tell your trainer about it. Otherwise, it could break on deploiement
PROJECT_NAME_SPECIFIC_NAME=YOUR_SPECIFIC_VALUE

# Position des comptes de test admin1..admin4 (seed). Optionnel : mettre des
# coordonnées près de chez vous, puis relancez npm run db:seed.
# Défaut : Westhalten, décalé d'environ 50 m par admin.
# SEED_ADMIN_1_LATITUDE=47.954352
# SEED_ADMIN_1_LONGITUDE=7.260492
# SEED_ADMIN_2_LATITUDE=
# SEED_ADMIN_2_LONGITUDE=
# SEED_ADMIN_3_LATITUDE=
# SEED_ADMIN_3_LONGITUDE=
# SEED_ADMIN_4_LATITUDE=
# SEED_ADMIN_4_LONGITUDE=
