{
	"name": "@js-monorepo/server",
	"scripts": {
		"check-types": "tsc --noEmit",
		"dev": "tsx watch --clear-screen=false ./src/main",
		"db:migrate": "tsx ./bin/migrate",
		"db:seed": "tsx ./bin/seed",
		"expire": "tsx ./bin/expire",
		"build": "tsx ./bin/migrate",
		"start": "tsx ./src/main",
		"test": "jest --verbose",
		"test:unit": "jest --verbose --testPathIgnorePatterns=/tests/"
	},
	"dependencies": {
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"http-status-codes": "^2.3.0",
		"mysql2": "^3.14.0",
		"nodemailer": "^10.0.10",
		"node-cron": "^4.6.0"
	},
	"devDependencies": {
		"@faker-js/faker": "^9.6.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.1",
		"@types/jest": "^29.5.14",
		"@types/nodemailer": "^8.0.2",
		"@types/node-cron": "^3.0.11",
		"@types/supertest": "^6.0.3",
		"jest": "^29.7.0",
		"supertest": "^7.1.0",
		"ts-jest": "^29.3.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2"
	}
}
